{
  "info": {
    "name": "实验4本侧三API（检测/文本/匹配）",
    "description": "已集成的图像检测、解说文本分类和图文匹配 API 请求示例。上传测试时请选择 complete_web_system/samples/images/ 中的图片。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    }
  ],
  "item": [
    {
      "name": "health 健康检查",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "meta 模型信息",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/meta/model"
      }
    },
    {
      "name": "detect 单张检测（正常）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/detect",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "conf",
              "value": "0.25",
              "type": "text"
            },
            {
              "key": "iou",
              "value": "0.55",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "detect 错误扩展名（400）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/detect",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "value": "not an image",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "text 解说文本分类（篮球）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/text/classify",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"詹姆斯外线三分出手命中！\"\n}"
        }
      }
    },
    {
      "name": "text 域外文本（判定非篮球）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/text/classify",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"今天天气晴朗适合出游\"\n}"
        }
      }
    },
    {
      "name": "text 空文本（400）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/text/classify",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"\"\n}"
        }
      }
    },
    {
      "name": "match 图文匹配（正常）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/match",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "text",
              "value": "精彩的突破上篮打进！",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "match 图文不匹配（文本域外）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/match",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            },
            {
              "key": "text",
              "value": "股市今日大幅上涨",
              "type": "text"
            }
          ]
        }
      }
    },
    {
      "name": "batch 批量检测（异步）",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/detect/batch",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "files",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    },
    {
      "name": "batch 查询进度",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/batch/:task_id"
      }
    },
    {
      "name": "batch 不存在任务（404）",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/batch/nonexistent"
      }
    }
  ]
}
