# 视频任务由独立 Worker 处理；本地默认不依赖 Redis
TASK_BACKEND=worker

# 每隔 N 帧抽取一帧进入视频检测
BASKETBALL_FRAME_STEP=2

# 单个视频上传上限（5 GiB）
BASKETBALL_MAX_UPLOAD_BYTES=5368709120

# 自动选择 CUDA GPU；无 CUDA 时使用 CPU
BASKETBALL_DEVICE=auto

# 动作识别（实验5 视觉动作线）：on 时检测后按 track 滑窗识别 14 类动作，产出 type=action 事件；
# 权重缺失或推理失败自动回退启发式事件，不影响任务完成。权重训练见 scripts/06_action/
# 部署用 FP32 ONNX（约 340ms/clip CPU；INT8 动态量化在 3D 卷积上反而慢 ~28 倍，不推荐）
BASKETBALL_ACTION=off
# BASKETBALL_ACTION_MODEL_PATH=weights/action_mc3_18.onnx
# BASKETBALL_ACTION_META_PATH=weights/action_clf_meta.json
# 动作事件置信度阈值与同 (track, 动作) 冷却毫秒数
# BASKETBALL_ACTION_CONF=0.6
# BASKETBALL_ACTION_COOLDOWN_MS=3000

# 视频事件解说：stub=模板句（默认，无需 key）；llm=大模型生成（失败/超时自动回退）
# 切到 llm 后需重启 Worker 进程才生效
BASKETBALL_COMMENTARY=stub
# 单任务最多调用几次大模型（默认 12，超出的走模板句）
BASKETBALL_COMMENTARY_MAX_CALLS=12
# 批量生成：一次调用产出 N 条事件解说，配额消耗降为 1/N（默认 5；1=逐条）
BASKETBALL_COMMENTARY_BATCH=5

# 视频解说"画面观察"（视觉大模型看事件时刻关键帧，作为解说第二事实源）：
# on 时每条真正生成解说的事件先抓帧→视觉模型描述→注入提示词；off 或视觉失败自动降级
BASKETBALL_VISION_CAPTIONS=on
# 单任务最多抓帧调视觉模型的次数（默认 16，超出不注入画面观察）
BASKETBALL_VISION_MAX_CALLS=16
# 视觉模型（须为多模态模型，复用 EXP5_LLM_BASE_URL/KEY；也可用 EXP5_VISION_BASE_URL/API_KEY 单独指定）
EXP5_VISION_MODEL=gpt-4o-mini

# TTS WebSocket proxy: auto reads system proxy, direct disables it, or set an HTTP URL.
BASKETBALL_TTS_PROXY=auto
