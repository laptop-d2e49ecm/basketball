# 原始数据与生成产物不入库（报告截图时本地查看即可）
data/raw/*
data/processed/*
data/splits/*
!data/raw/*/.gitkeep
!data/processed/*/.gitkeep
!data/processed/*/*/.gitkeep
!data/splits/.gitkeep

__pycache__/
*.pyc
.ipynb_checkpoints/
.idea/
.vscode/
*.log

# 本机 torch DLL 兼容修复用的运行库副本（二进制不分发，见 docs/PROVENANCE.md 问题 9）
vendor/*.dll

# Python 虚拟环境（通过 requirements.txt 重建）
.venv/
venv/

# 模型权重与训练产物（大文件，走压缩包/网盘分发，不入库）
runs/
*.pt
*.pth
*.onnx
*.ckpt
*.partial

# models/ 目录：权重与 P2 交付包内的数据集图片副本不入库，保留证据链小文件
# （README、结果 json、脚本、曲线图等，见 models/exp3/README.md）
models/**/*.engine
models/**/*.xml
models/**/*.bin
models/**/*.npz
models/**/*.jpg
models/**/*.txt
models/**/*.pyc
models/**/*.cache

# 交接/分享压缩包及解压目录
*.zip
*.tar
*.tar.gz
*.7z
share_*/

# 报告构建产物
.report_build/

# 实验 4：前端与后端运行产物（依赖与产物可重建，不入库；指标 json 保留作证据）
node_modules/
dist/
*.joblib
.pytest_cache/
exp4/backend/tasks.db
exp4/backend/runs/
exp4/backend/static/

